# Razorpay production configuration.
# Use the live credentials from the Razorpay Dashboard for real charges.
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Development alternative:
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_test_key_secret

WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_number_id
WHATSAPP_PROVIDER=metaWHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_number_id
WHATSAPP_PROVIDER=meta
WHATSAPP_WEBHOOK_SECRET=your_meta_webhook_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token